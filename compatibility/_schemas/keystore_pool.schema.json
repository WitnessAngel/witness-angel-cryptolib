{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keystore_pool.schema.json",
  "title": "Sidecar of a keystore pool fixture (a FilesystemKeystorePool directory)",
  "type": "object",
  "allOf": [{"$ref": "_defs.schema.json#/$defs/header"}],
  "properties": {
    "fixture_kind": {"const": "keystore_pool"},
    "local_keyfactory": {
      "type": "object",
      "properties": {
        "keypairs": {"type": "array", "items": {"$ref": "_defs.schema.json#/$defs/keypair_identifier"}}
      },
      "required": ["keypairs"],
      "additionalProperties": false
    },
    "authenticators": {
      "description": "Authenticator keystores imported into the pool (foreign keystores)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keystore_uid": {"$ref": "_defs.schema.json#/$defs/uuid"},
          "keystore_owner": {"type": "string", "minLength": 1},
          "keystore_passphrase_hint": {"type": "string"},
          "passphrase": {
            "description": "Dummy passphrase protecting all private keys of this authenticator",
            "type": "string",
            "minLength": 1
          },
          "keypairs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "_defs.schema.json#/$defs/keypair_identifier"}
          }
        },
        "required": ["keystore_uid", "keystore_owner", "passphrase", "keypairs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["local_keyfactory", "authenticators"],
  "unevaluatedProperties": false
}
