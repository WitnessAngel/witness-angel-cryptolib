     return HMAC(key, msg, digestmod)
 
 
+def compare_digest(a, b):
+    # Like CPython's, its duration only depends on the lengths of the byte strings, not on their contents
+    result = len(a) ^ len(b)
+    for x, y in zip(a, b):
+        result |= x ^ y
+    return result == 0
